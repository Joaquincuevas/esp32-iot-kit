# Copy to .env and replace every value. .env is git-ignored.
# Generate strong values with: openssl rand -hex 24

# MQTT (Mosquitto). The ESP32 config.h must use the same user/password.
MQTT_USER=esp32
MQTT_PASSWORD=change-me-mqtt

# InfluxDB 2 (initial setup runs only on the first start of an empty volume)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-influx-admin
INFLUX_ORG=esp32-iot-kit
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=change-me-influx-token

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
